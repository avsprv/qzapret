<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>qzapret</vendor>
  <vendor_url>https://github.com/avsprv/qzapret</vendor_url>

  <action id="org.qzapret.helper">
    <description>Manage zapret2 and run DPI strategy scan</description>
    <description xml:lang="ru">Управление zapret2 и подбор стратегий обхода DPI</description>
    <message>Authentication is required to manage zapret2</message>
    <message xml:lang="ru">Для управления zapret2 требуется аутентификация</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@QZAPRET_HELPER@</annotate>
  </action>
</policyconfig>
