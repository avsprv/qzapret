#!/bin/sh
# zapret2applet-helper — единственная привилегированная часть zapret2applet.
# Запускается от root через pkexec/polkit. Принимает ТОЛЬКО перечисленные ниже
# команды и строго валидирует аргументы; окружение вызывающего не используется.
set -eu

UNIT=zapret2.service
BASE=/opt/zapret2
BACKUP_ROOT=/var/backups/zapret2applet
RUNDIR=/run/zapret2applet
URLBASE=https://github.com/bol-van/zapret2/releases/download
PROTO='=https'
NOSVC=0
JOURNALCTL=journalctl

# Переопределения ТОЛЬКО для тестов. Игнорируются, если хелпер установлен в системный
# каталог; кроме того, pkexec сам очищает окружение вызывающего.
case "$0" in
    /usr/*|/opt/*|/etc/*|/bin/*|/sbin/*|/lib/*|/var/*) ;;
    *)
        if [ -n "${QZAPRET_TEST_BASE:-}" ]; then BASE=$QZAPRET_TEST_BASE; fi
        if [ -n "${QZAPRET_TEST_BACKUP_DIR:-}" ]; then BACKUP_ROOT=$QZAPRET_TEST_BACKUP_DIR; fi
        if [ -n "${QZAPRET_TEST_RUNDIR:-}" ]; then RUNDIR=$QZAPRET_TEST_RUNDIR; fi
        if [ -n "${QZAPRET_TEST_URLBASE:-}" ]; then URLBASE=$QZAPRET_TEST_URLBASE; PROTO='=https,file'; fi
        if [ -n "${QZAPRET_TEST_NO_SERVICE:-}" ]; then NOSVC=1; fi
        if [ -n "${QZAPRET_TEST_JOURNALCTL:-}" ]; then JOURNALCTL=$QZAPRET_TEST_JOURNALCTL; fi
        ;;
esac
PIDFILE=$RUNDIR/blockcheck.pid

die() { echo "zapret2applet-helper: $*" >&2; exit 2; }

# pid жив и это действительно blockcheck2.sh (защита от переиспользованного pid)
bc_pid() {
    [ -r "$PIDFILE" ] || return 1
    pid=$(cat "$PIDFILE" 2>/dev/null) || return 1
    case "$pid" in ''|*[!0-9]*) return 1 ;; esac
    [ -r "/proc/$pid/cmdline" ] || return 1
    tr '\0' ' ' < "/proc/$pid/cmdline" | grep -q 'blockcheck2\.sh' || return 1
    echo "$pid"
}

need_arg() { [ "$1" -ge 2 ] || die "missing value for $2"; }

case "${1:-}" in
lists-write)
    [ "$#" -eq 2 ] || die "usage: lists-write NAME"
    case "$2" in
        zapret-hosts-user.txt|zapret-hosts-user-exclude.txt|zapret-hosts-user-ipban.txt) ;;
        *) die "only source user hostlists are writable" ;;
    esac
    [ -d "$BASE" ] && [ ! -L "$BASE" ] || die "zapret2 not found in $BASE"
    ipset_dir="$BASE/ipset"
    [ -d "$ipset_dir" ] && [ ! -L "$ipset_dir" ] || die "ipset directory is missing or unsafe"
    list="$ipset_dir/$2"
    [ ! -L "$list" ] || die "list file must not be a symlink"
    if [ -e "$list" ] && [ ! -f "$list" ]; then die "list is not a regular file"; fi

    tmp=$(mktemp "$ipset_dir/.list.zapret2applet.XXXXXX") || die "cannot create temporary list"
    trap 'rm -f "$tmp"' EXIT HUP INT TERM
    head -c 1048577 > "$tmp"
    size=$(wc -c < "$tmp" | tr -d '[:space:]')
    case "$size" in ''|*[!0-9]*) die "cannot determine staged list size" ;; esac
    [ "$size" -le 1048576 ] || die "list exceeds the 1 MiB write limit"
    LC_ALL=C awk '
        NR > 50000 { exit 1 }
        length($0) > 4095 { exit 1 }
        /[[:cntrl:]]/ { exit 1 }
        /[[:space:]]/ { exit 1 }
        /[^A-Za-z0-9.\/: -]/ { exit 1 }
    ' "$tmp" || die "invalid hostlist text; use one plain entry per line"

    if [ -e "$list" ]; then
        [ -f "$list" ] && [ ! -L "$list" ] || die "list changed to an unsafe file"
        chmod --reference="$list" "$tmp" || die "cannot preserve list permissions"
        chown --reference="$list" "$tmp" || die "cannot preserve list ownership"
    else
        chmod 644 "$tmp" || die "cannot set new list permissions"
        chown --reference="$ipset_dir" "$tmp" || die "cannot set new list ownership"
    fi

    if [ -e "$BACKUP_ROOT" ] && { [ ! -d "$BACKUP_ROOT" ] || [ -L "$BACKUP_ROOT" ]; }; then
        die "backup directory is unsafe"
    fi
    [ -d "$BACKUP_ROOT" ] || { mkdir -p "$BACKUP_ROOT" && chmod 700 "$BACKUP_ROOT"; } || die "cannot create backup directory"
    list_backup_root="$BACKUP_ROOT/lists"
    if [ -e "$list_backup_root" ] && { [ ! -d "$list_backup_root" ] || [ -L "$list_backup_root" ]; }; then
        die "list backup directory is unsafe"
    fi
    [ -d "$list_backup_root" ] || { mkdir "$list_backup_root" && chmod 700 "$list_backup_root"; } || die "cannot create list backup directory"
    chmod 700 "$list_backup_root" || die "cannot secure list backup directory"

    backup=""
    if [ -e "$list" ]; then
        backup=$(mktemp -d "$list_backup_root/$2-$(date +%Y%m%d-%H%M%S)-XXXXXX") || die "cannot create list backup"
        cp -p "$list" "$backup/list" || { rm -rf "$backup"; die "cannot back up current list"; }
        chmod 600 "$backup/list" || { rm -rf "$backup"; die "cannot secure list backup"; }
    fi

    sync -f "$tmp" || { [ -z "$backup" ] || rm -rf "$backup"; die "cannot sync staged list"; }
    mv -f -- "$tmp" "$list" || { [ -z "$backup" ] || rm -rf "$backup"; die "atomic list replacement failed"; }
    sync -f "$ipset_dir" || true
    trap - EXIT HUP INT TERM
    if [ -n "$backup" ]; then
        echo "OK: list updated; backup: $backup"
    else
        echo "OK: list created; no previous file existed"
    fi
    ;;
logs-read)
    [ "$#" -eq 2 ] || die "usage: logs-read {50|100|200|500}"
    case "$2" in 50|100|200|500) lines=$2 ;; *) die "log line count is not allowlisted" ;; esac
    command -v "$JOURNALCTL" >/dev/null 2>&1 || die "journalctl is not available"
    umask 077
    tmp=$(mktemp /tmp/zapret2applet-journal.XXXXXX) || die "cannot create temporary journal output"
    err=$(mktemp /tmp/zapret2applet-journal-error.XXXXXX) || {
        rm -f "$tmp"
        die "cannot create temporary journal error output"
    }
    trap 'rm -f "$tmp" "$err"' EXIT HUP INT TERM
    if ! "$JOURNALCTL" --unit="$UNIT" --lines="$lines" --no-pager --output=short-iso > "$tmp" 2> "$err"; then
        message=$(cat "$err")
        [ -n "$message" ] || message="journalctl exited unsuccessfully"
        die "cannot read service journal: $message"
    fi
    size=$(wc -c < "$tmp" | tr -d '[:space:]')
    case "$size" in ''|*[!0-9]*) die "cannot determine journal output size" ;; esac
    if [ "$size" -gt 1048576 ]; then
        printf '[zapret2applet: output truncated to the most recent 1 MiB]\n'
        tail -c 1048500 "$tmp"
    else
        cat "$tmp"
    fi
    ;;
lists-read)
    [ "$#" -eq 2 ] || die "usage: lists-read NAME"
    case "$2" in
        zapret-hosts-user.txt|zapret-hosts-user-exclude.txt|zapret-hosts-user-ipban.txt|zapret-ip-user.txt|zapret-ip-user6.txt|zapret-ip-exclude.txt|zapret-ip-exclude6.txt|zapret-ip-user-ipban.txt|zapret-ip-user-ipban6.txt) ;;
        *) die "list name is not allowlisted" ;;
    esac
    [ -d "$BASE" ] && [ ! -L "$BASE" ] || die "zapret2 not found in $BASE"
    ipset_dir="$BASE/ipset"
    [ -d "$ipset_dir" ] && [ ! -L "$ipset_dir" ] || die "ipset directory is missing or unsafe"
    list="$ipset_dir/$2"
    [ -e "$list" ] || { echo "zapret2applet-helper: list file does not exist" >&2; exit 3; }
    [ -f "$list" ] && [ ! -L "$list" ] || die "list is not a regular file"
    size=$(wc -c < "$list" | tr -d '[:space:]')
    case "$size" in ''|*[!0-9]*) die "cannot determine list size" ;; esac
    [ "$size" -le 1048576 ] || die "list exceeds the 1 MiB read limit"
    cat "$list"
    ;;
config-read)
    [ "$#" -eq 1 ] || die "usage: config-read"
    [ -d "$BASE" ] && [ ! -L "$BASE" ] || die "zapret2 not found in $BASE"
    config="$BASE/config"
    [ -f "$config" ] && [ ! -L "$config" ] || die "config is missing or is not a regular file"
    size=$(wc -c < "$config" | tr -d '[:space:]')
    case "$size" in ''|*[!0-9]*) die "cannot determine config size" ;; esac
    [ "$size" -le 1048576 ] || die "config exceeds the 1 MiB read limit"
    cat "$config"
    ;;
config-write)
    [ "$#" -ge 1 ] && [ "$#" -le 2 ] || die "usage: config-write [EXPECTED_SHA256]"
    [ -d "$BASE" ] && [ ! -L "$BASE" ] || die "zapret2 not found in $BASE"
    config="$BASE/config"
    [ -f "$config" ] && [ ! -L "$config" ] || die "config is missing or is not a regular file"
    expected_hash=""
    if [ "$#" -eq 2 ]; then
        expected_hash=$2
        case "$expected_hash" in ''|*[!0-9a-f]*) die "invalid expected config SHA-256" ;; esac
        [ "${#expected_hash}" -eq 64 ] || die "invalid expected config SHA-256"
        command -v sha256sum >/dev/null 2>&1 || die "sha256sum is required for guarded config writes"
        current_hash=$(sha256sum "$config" | awk '{print $1}')
        [ "$current_hash" = "$expected_hash" ] || die "config changed since it was read; reload before saving"
    fi
    tmp=$(mktemp "$BASE/.config.zapret2applet.XXXXXX") || die "cannot create temporary config"
    trap 'rm -f "$tmp"' EXIT HUP INT TERM
    head -c 1048577 > "$tmp"
    size=$(wc -c < "$tmp" | tr -d '[:space:]')
    case "$size" in ''|*[!0-9]*) die "cannot determine staged config size" ;; esac
    [ "$size" -le 1048576 ] || die "config exceeds the 1 MiB write limit"
    sh -n "$tmp" || die "shell syntax validation failed; config was not changed"
    chmod --reference="$config" "$tmp" || die "cannot preserve config permissions"
    chown --reference="$config" "$tmp" || die "cannot preserve config ownership"
    [ -d "$BACKUP_ROOT" ] && [ ! -L "$BACKUP_ROOT" ] || {
        [ ! -e "$BACKUP_ROOT" ] && mkdir -p "$BACKUP_ROOT" && chmod 700 "$BACKUP_ROOT"
    } || die "backup directory is unsafe or unavailable"
    backup=$(mktemp -d "$BACKUP_ROOT/config-$(date +%Y%m%d-%H%M%S)-XXXXXX") || die "cannot create backup directory"
    cp -p "$config" "$backup/config" || { rm -rf "$backup"; die "cannot create config backup; config was not changed"; }
    chmod 600 "$backup/config" || { rm -rf "$backup"; die "cannot secure config backup; config was not changed"; }
    if [ -n "$expected_hash" ]; then
        backup_hash=$(sha256sum "$backup/config" | awk '{print $1}')
        [ "$backup_hash" = "$expected_hash" ] || {
            rm -rf "$backup"
            die "config changed while preparing the write; reload before saving"
        }
        current_hash=$(sha256sum "$config" | awk '{print $1}')
        [ "$current_hash" = "$expected_hash" ] || {
            rm -rf "$backup"
            die "config changed while preparing the write; reload before saving"
        }
    fi
    sync -f "$tmp" || { rm -rf "$backup"; die "cannot sync staged config; config was not changed"; }
    mv -f -- "$tmp" "$config" || { rm -rf "$backup"; die "atomic config replacement failed"; }
    sync -f "$BASE" || true
    trap - EXIT HUP INT TERM
    echo "OK: config updated; backup: $backup"
    ;;
config-rollback)
    [ "$#" -eq 1 ] || die "usage: config-rollback"
    [ -d "$BASE" ] && [ ! -L "$BASE" ] || die "zapret2 not found in $BASE"
    config="$BASE/config"
    [ -f "$config" ] && [ ! -L "$config" ] || die "config is missing or is not a regular file"
    [ -d "$BACKUP_ROOT" ] && [ ! -L "$BACKUP_ROOT" ] || die "no config backups found"
    restore=$(ls -1dt "$BACKUP_ROOT"/config-* 2>/dev/null | head -n 1)
    [ -n "$restore" ] && [ -d "$restore" ] && [ ! -L "$restore" ] || die "no config backups found"
    [ -f "$restore/config" ] && [ ! -L "$restore/config" ] || die "latest config backup is invalid"
    tmp=$(mktemp "$BASE/.config.zapret2applet.XXXXXX") || die "cannot create temporary config"
    trap 'rm -f "$tmp"' EXIT HUP INT TERM
    cp "$restore/config" "$tmp" || die "cannot stage backup"
    sh -n "$tmp" || die "backup failed shell syntax validation"
    chmod --reference="$config" "$tmp" || die "cannot preserve config permissions"
    chown --reference="$config" "$tmp" || die "cannot preserve config ownership"
    backup=$(mktemp -d "$BACKUP_ROOT/config-$(date +%Y%m%d-%H%M%S)-XXXXXX") || die "cannot preserve current config before rollback"
    cp -p "$config" "$backup/config" || { rm -rf "$backup"; die "cannot preserve current config; rollback canceled"; }
    chmod 600 "$backup/config" || { rm -rf "$backup"; die "cannot secure rollback backup"; }
    sync -f "$tmp" || { rm -rf "$backup"; die "cannot sync rollback config"; }
    mv -f -- "$tmp" "$config" || { rm -rf "$backup"; die "atomic rollback failed"; }
    sync -f "$BASE" || true
    trap - EXIT HUP INT TERM
    echo "OK: config restored from $restore; previous config backed up to $backup"
    ;;
unit)
    case "${2:-}" in
        start|stop|enable|disable) exec systemctl "$2" "$UNIT" ;;
        *) die "bad unit action" ;;
    esac
    ;;
blockcheck)
    shift
    domains=rutracker.org ipvs=4 http=1 tls12=1 tls13=0 http3=0 repeats=1 scan=standard
    while [ $# -gt 0 ]; do
        need_arg $# "$1"
        case "$1" in
            --domains)   domains=$2 ;;
            --ipvs)      ipvs=$2 ;;
            --http)      http=$2 ;;
            --tls12)     tls12=$2 ;;
            --tls13)     tls13=$2 ;;
            --http3)     http3=$2 ;;
            --repeats)   repeats=$2 ;;
            --scanlevel) scan=$2 ;;
            *) die "unknown option $1" ;;
        esac
        shift 2
    done

    n=0
    for d in $domains; do
        case "$d" in ''|*[!A-Za-z0-9.-]*|-*|.*) die "bad domain: $d" ;; esac
        [ ${#d} -le 253 ] || die "domain too long"
        n=$((n + 1))
    done
    [ "$n" -ge 1 ] && [ "$n" -le 10 ] || die "1..10 domains required"
    case "$ipvs" in 4|6|46) ;; *) die "bad ipvs" ;; esac
    for f in "$http" "$tls12" "$tls13" "$http3"; do
        case "$f" in 0|1) ;; *) die "flag must be 0 or 1" ;; esac
    done
    case "$repeats" in ''|*[!0-9]*) die "bad repeats" ;; esac
    [ "$repeats" -ge 1 ] && [ "$repeats" -le 10 ] || die "repeats must be 1..10"
    case "$scan" in veryquick|quick|standard|force) ;; *) die "bad scanlevel" ;; esac

    [ -f "$BASE/blockcheck2.sh" ] || die "zapret2 not found in $BASE"
    bc_pid >/dev/null && die "blockcheck already running"

    umask 022
    mkdir -p "$RUNDIR"
    echo $$ > "$PIDFILE"
    # exec сохраняет pid, поэтому blockcheck-cancel найдёт именно этот процесс
    exec env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME=/root LANG=C.UTF-8 \
        BATCH=1 DOMAINS="$domains" IPVS="$ipvs" \
        ENABLE_HTTP="$http" ENABLE_HTTPS_TLS12="$tls12" \
        ENABLE_HTTPS_TLS13="$tls13" ENABLE_HTTP3="$http3" \
        REPEATS="$repeats" SCANLEVEL="$scan" \
        sh "$BASE/blockcheck2.sh"
    ;;
blockcheck-cancel)
    pid=$(bc_pid) || { echo "zapret2applet-helper: blockcheck is not running" >&2; exit 0; }
    # SIGINT: обработчик blockcheck2.sh печатает "terminating..." и чистит правила/процессы.
    # Если процесс стартовал с игнорируемым SIGINT, через ~3 с шлём SIGTERM (обработчик
    # sigsilent делает ту же очистку). SIGKILL не используем: он оставил бы правила nft.
    kill -INT "$pid" 2>/dev/null || exit 0
    for _ in 1 2 3; do
        sleep 1
        bc_pid >/dev/null || exit 0
    done
    kill -TERM "$pid" 2>/dev/null || true
    ;;
update)
    # update vX.Y.Z — скачать релиз zapret2 с github.com/bol-van/zapret2 и обновить $BASE.
    # Файлы пользователя (config, ipset/zapret-hosts-user*.txt, init.d/*/custom.d) в архиве
    # отсутствуют, поэтому наложение файлов поверх их не затрагивает.
    tag=${2:-}
    case "$tag" in v[0-9]*) ;; *) die "bad tag" ;; esac
    case "$tag" in *[!0-9.v]*|*..*|*.|v*v*) die "bad tag" ;; esac
    [ ${#tag} -le 24 ] || die "bad tag"
    [ -d "$BASE" ] && [ ! -L "$BASE" ] || die "zapret2 not found in $BASE"
    [ -f "$BASE/install_bin.sh" ] || die "$BASE does not look like zapret2"
    command -v curl >/dev/null 2>&1 || die "curl is required"
    command -v sha256sum >/dev/null 2>&1 || die "sha256sum is required"
    bc_pid >/dev/null && die "blockcheck is running, cancel it first"

    umask 022
    mkdir -p "$RUNDIR"
    mkdir "$RUNDIR/update.lock" 2>/dev/null || die "another update is in progress"
    name="zapret2-$tag"
    tmp=$(mktemp -d /var/tmp/zapret2applet-update.XXXXXX) || { rmdir "$RUNDIR/update.lock"; die "mktemp failed"; }
    trap 'rm -rf "$tmp"; rmdir "$RUNDIR/update.lock" 2>/dev/null || true' EXIT

    fetch() {
        curl -fsSL --proto "$PROTO" --proto-redir '=https' --tlsv1.2 \
            --connect-timeout 20 --max-time 600 --max-filesize 300000000 -o "$2" "$1"
    }
    echo "Downloading $name.tar.gz ..."
    fetch "$URLBASE/$tag/$name.tar.gz" "$tmp/z.tgz" || die "download failed"
    fetch "$URLBASE/$tag/sha256sum.txt" "$tmp/sums.txt" || die "download of sha256sum.txt failed"

    echo "Checking archive ..."
    tar -tzf "$tmp/z.tgz" > "$tmp/list" 2>/dev/null || die "corrupt archive"
    [ -s "$tmp/list" ] || die "empty archive"
    if grep -qE '(^/|(^|/)\.\.(/|$))' "$tmp/list"; then die "unsafe paths in archive"; fi
    if grep -qv "^$name/" "$tmp/list"; then die "unexpected content outside $name/"; fi
    # только обычные файлы и каталоги: ни ссылок, ни устройств
    if tar -tvzf "$tmp/z.tgz" | cut -c1 | grep -qv '[-d]'; then die "links or special files in archive"; fi

    mkdir "$tmp/x"
    tar -xzf "$tmp/z.tgz" -C "$tmp/x" --no-same-owner || die "extract failed"
    stage="$tmp/x/$name"
    [ -d "$stage" ] || die "unexpected archive layout"
    chmod -R ug-s "$stage"

    echo "Verifying checksums of binaries (sha256sum.txt from the release) ..."
    [ -s "$tmp/sums.txt" ] || die "empty sha256sum.txt"
    if grep -qvE "^[0-9a-f]{64}  $name/binaries/[A-Za-z0-9._/+-]+\$" "$tmp/sums.txt"; then
        die "unexpected sha256sum.txt format"
    fi
    ( cd "$tmp/x" && sha256sum -c --quiet "$tmp/sums.txt" ) || die "checksum mismatch, nothing was changed"

    for f in blockcheck2.sh install_bin.sh docs/changes.txt; do
        [ -f "$stage/$f" ] || die "archive has no $f"
    done
    newver=$(grep -E '^[0-9]+(\.[0-9]+)+[[:space:]]*$' "$stage/docs/changes.txt" | tail -n 1 | tr -d '[:space:]')
    [ "$newver" = "${tag#v}" ] || die "version mismatch: archive says '$newver', expected '${tag#v}'"

    svc() { [ "$NOSVC" = 1 ] || systemctl "$1" "$UNIT"; }
    was_active=0
    if [ "$NOSVC" != 1 ] && systemctl is-active --quiet "$UNIT" 2>/dev/null; then was_active=1; fi
    [ "$was_active" = 1 ] && { echo "Stopping $UNIT ..."; svc stop || die "cannot stop $UNIT"; }

    bak="$BASE.bak"
    rm -rf "$bak"
    echo "Backing up the current installation to $bak ..."
    if ! cp -a "$BASE" "$bak"; then
        rm -rf "$bak"
        [ "$was_active" = 1 ] && svc start || true
        die "backup failed, nothing was changed"
    fi

    rollback() {
        echo "Rolling back to the previous version ..." >&2
        rm -rf "$BASE" && mv "$bak" "$BASE" || echo "zapret2applet-helper: ROLLBACK FAILED, previous version is in $bak" >&2
        [ "$was_active" = 1 ] && svc start || true
    }

    echo "Installing $tag into $BASE ..."
    cp -a "$stage/." "$BASE/" || { rollback; die "copy failed"; }
    env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME=/root LANG=C.UTF-8 \
        sh "$BASE/install_bin.sh" </dev/null >"$tmp/install_bin.log" 2>&1 \
        || { cat "$tmp/install_bin.log" >&2; rollback; die "install_bin.sh failed"; }
    "$BASE/nfq2/nfqws2" --version >/dev/null 2>&1 || { rollback; die "nfqws2 does not run on this system"; }

    [ "$was_active" = 1 ] && { echo "Starting $UNIT ..."; svc start || echo "zapret2applet-helper: WARNING: cannot start $UNIT" >&2; }
    echo "OK: zapret2 updated to $tag (previous version kept in $bak)"
    ;;
*)
    die "usage: zapret2applet-helper logs-read {50|100|200|500} | lists-read NAME | lists-write NAME | config-read | config-write [EXPECTED_SHA256] | config-rollback | unit {start|stop|enable|disable} | blockcheck [opts] | blockcheck-cancel | update vX.Y.Z"
    ;;
esac
